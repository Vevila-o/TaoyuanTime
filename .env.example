DJANGO_SECRET_KEY=change-me
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_USER_ID=
# Keep true unless this PC must use a system proxy for LINE/OpenAI.`r`nLINE_DISABLE_PROXY=true
PUBLIC_BASE_URL=https://your-ngrok-domain.ngrok-free.app
LINE_WEBHOOK_PATH=/callback/
# Optional. If omitted, the app uses Database\db.sqlite3 in this project.
# TAOYUANTIME_DB_PATH=C:\Users\xxxxxx\Desktop\TaoyuanTime-intergrate1\Database\db.sqlite3

# Default for another PC: skip local AI and use OpenAI cloud directly.
LOCAL=not
AI_LOCAL_ENABLED=not
AI_BASE_URL=
AI_PROVIDER_ORDER=local,openai

# Optional local OpenAI-compatible model server. To enable it, set LOCAL=true and fill AI_BASE_URL.
# LOCAL=true
# AI_BASE_URL=http://100.107.195.9:8080/v1
AI_API_KEY=sk-no-key-required
AI_MODEL=qwen
AI_TIMEOUT_MS=60000
# 1024 is enough for LINE query JSON, AI Tag, short summaries, and normal OCR. Use 2048/4096 if OCR JSON is truncated.`r`nAI_MAX_TOKENS=1024

# OpenAI cloud fallback / default.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-real-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

